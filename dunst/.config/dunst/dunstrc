[global]
    monitor = 0
    follow = mouse
    width = 360
    height = (0, 140)
    origin = top-right
    offset = (18, 18)
    scale = 0
    notification_limit = 8

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 0
    separator_height = 0
    padding = 16
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 1
    frame_color = "#7c8fa3"
    corner_radius = 18

    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    background = "#1e293bcc"
    foreground = "#eef4fb"
    timeout = 6

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e293bcc"
    foreground = "#eef4fb"
    frame_color = "#6b7c8f"
    timeout = 4

[urgency_normal]
    background = "#1e293bcc"
    foreground = "#eef4fb"
    frame_color = "#88c0d0"
    timeout = 6

[urgency_critical]
    background = "#2d1f2aee"
    foreground = "#ffffff"
    frame_color = "#e06c75"
    timeout = 0
